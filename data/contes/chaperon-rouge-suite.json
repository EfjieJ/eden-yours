{
 "about": "Suite du conte (scènes 4–15), chargée par js/eden-paid.js seulement après déblocage. Générée par tools/build-chaperon-rouge.py.",
 "key": "chaperon-rouge",
 "first": 4,
 "scenes": [
  "      <section class=\"conte-scene\" id=\"scene-4\" data-scene=\"4\">\n        <figure class=\"conte-fig\">\n            <img class=\"conte-img is-on\" data-beat=\"c04a\" src=\"assets/contes/chaperon-rouge/sm/c04a.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c04a.webp 640w, assets/contes/chaperon-rouge/c04a.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"La mère de Rouge lui tend une corbeille pour sa grand-mère\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c04b\" src=\"assets/contes/chaperon-rouge/sm/c04b.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c04b.webp 640w, assets/contes/chaperon-rouge/c04b.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge observe la corbeille et sent une dissonance\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c04c\" src=\"assets/contes/chaperon-rouge/sm/c04c.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c04c.webp 640w, assets/contes/chaperon-rouge/c04c.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge murmure à sa mère\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c04d\" src=\"assets/contes/chaperon-rouge/sm/c04d.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c04d.webp 640w, assets/contes/chaperon-rouge/c04d.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Dans la corbeille : des pétales de fleurs séchées imprégnés de lumière et une fiole d’eau scintillante\" loading=\"lazy\" decoding=\"async\">\n          <span class=\"conte-dots\" aria-hidden=\"true\"><i data-beat=\"c04a\" class=\"is-on\"></i><i data-beat=\"c04b\"></i><i data-beat=\"c04c\"></i><i data-beat=\"c04d\"></i></span>\n        </figure>\n        <div class=\"conte-text conte-text--lignes\"><p><span class=\"beat\" data-beat=\"c04a\">Un matin, sa mère lui dit : « Rouge, va voir ta grand-mère, elle est faible et a besoin de toi. Apporte-lui cette corbeille de pain et de viande pour la sustenter. » </span><span class=\"beat\" data-beat=\"c04b\">Mais Rouge, guidée par son supramental, observa la corbeille et sentit une dissonance. </span><span class=\"beat\" data-beat=\"c04c\">« Maman, ces aliments viennent de vies arrachées », murmura-t-elle. </span><span class=\"beat\" data-beat=\"c04d\">Elle vida la corbeille et y plaça des pétales de fleurs séchées, imprégnés de lumière , et une fiole d’eau scintillante, qu’elle avait infusée de son amour.</span><span class=\"conte-sep\" hidden>\n</span></p></div>\n        <button type=\"button\" class=\"btn btn-ghost conte-next\" data-i18n=\"conte.next\">Suite ▾</button>\n      </section>",
  "      <section class=\"conte-scene\" id=\"scene-5\" data-scene=\"5\">\n        <figure class=\"conte-fig\">\n            <img class=\"conte-img is-on\" data-beat=\"c05a\" src=\"assets/contes/chaperon-rouge/sm/c05a.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c05a.webp 640w, assets/contes/chaperon-rouge/c05a.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge marche sur le chemin ; les rayons du soleil dansent à travers les feuilles\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c05b\" src=\"assets/contes/chaperon-rouge/sm/c05b.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c05b.webp 640w, assets/contes/chaperon-rouge/c05b.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Une ombre entre les arbres : le loup, aux yeux perçants\" loading=\"lazy\" decoding=\"async\">\n          <span class=\"conte-dots\" aria-hidden=\"true\"><i data-beat=\"c05a\" class=\"is-on\"></i><i data-beat=\"c05b\"></i></span>\n        </figure>\n        <div class=\"conte-text conte-text--lignes\"><p><span class=\"beat\" data-beat=\"c05a\">Sur le chemin, alors que les rayons du soleil dansaient à travers les feuilles, </span><span class=\"beat\" data-beat=\"c05b\">Rouge sentit une ombre : le loup, aux yeux perçants et à la démarche furtive.</span><span class=\"conte-sep\" hidden> \n</span></p></div>\n        <button type=\"button\" class=\"btn btn-ghost conte-next\" data-i18n=\"conte.next\">Suite ▾</button>\n      </section>",
  "      <section class=\"conte-scene\" id=\"scene-6\" data-scene=\"6\">\n        <figure class=\"conte-fig\">\n            <img class=\"conte-img is-on\" data-beat=\"c06a\" src=\"assets/contes/chaperon-rouge/sm/c06a.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c06a.webp 640w, assets/contes/chaperon-rouge/c06a.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge, calme, porte attention\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c06b\" src=\"assets/contes/chaperon-rouge/sm/c06b.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c06b.webp 640w, assets/contes/chaperon-rouge/c06b.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge perçoit que le loup est prisonnier d’un vieux programme, comme des fils gris autour de lui\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c06c\" src=\"assets/contes/chaperon-rouge/sm/c06c.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c06c.webp 640w, assets/contes/chaperon-rouge/c06c.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge parle doucement au loup\" loading=\"lazy\" decoding=\"async\">\n          <span class=\"conte-dots\" aria-hidden=\"true\"><i data-beat=\"c06a\" class=\"is-on\"></i><i data-beat=\"c06b\"></i><i data-beat=\"c06c\"></i></span>\n        </figure>\n        <div class=\"conte-text conte-text--lignes\"><p><span class=\"beat\" data-beat=\"c06a\">Mais Rouge, au lieu de trembler, porta attention . </span><span class=\"beat\" data-beat=\"c06b\">Elle observa le loup et perçut qu’il était prisonnier d’un programme ancien – la faim, le besoin de dévorer pour survivre. </span><span class=\"beat\" data-beat=\"c06c\">« Loup », dit-elle, sa voix claire comme une Parole sans mots , « tu crois devoir manger pour vivre, mais viens, observons ensemble. »</span></p></div>\n        <button type=\"button\" class=\"btn btn-ghost conte-next\" data-i18n=\"conte.next\">Suite ▾</button>\n      </section>",
  "      <section class=\"conte-scene\" id=\"scene-7\" data-scene=\"7\">\n        <figure class=\"conte-fig\">\n            <img class=\"conte-img is-on\" data-beat=\"c07a\" src=\"assets/contes/chaperon-rouge/sm/c07a.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c07a.webp 640w, assets/contes/chaperon-rouge/c07a.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Le loup, déconcerté, s’arrête devant l’enfant si calme\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c07b\" src=\"assets/contes/chaperon-rouge/sm/c07b.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c07b.webp 640w, assets/contes/chaperon-rouge/c07b.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge ferme les yeux ; la lumière rayonne d’elle\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c07c\" src=\"assets/contes/chaperon-rouge/sm/c07c.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c07c.webp 640w, assets/contes/chaperon-rouge/c07c.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge et le loup assis près d’une rivière : la lumière est partout\" loading=\"lazy\" decoding=\"async\">\n          <span class=\"conte-dots\" aria-hidden=\"true\"><i data-beat=\"c07a\" class=\"is-on\"></i><i data-beat=\"c07b\"></i><i data-beat=\"c07c\"></i></span>\n        </figure>\n        <div class=\"conte-text conte-text--lignes\"><p><span class=\"beat\" data-beat=\"c07a\">Le loup, déconcerté par cette enfant si calme, s’arrêta. </span><span class=\"beat\" data-beat=\"c07b\">Rouge ferma les yeux, laissant la lumière en elle rayonner. </span><span class=\"beat\" data-beat=\"c07c\">« Regarde, loup, la lumière est partout. Elle nourrit les arbres, les rivières, et nous. Tu n’as pas à arracher ma vie ou celle d’un autre. »</span><span class=\"conte-sep\" hidden> \n</span></p></div>\n        <button type=\"button\" class=\"btn btn-ghost conte-next\" data-i18n=\"conte.next\">Suite ▾</button>\n      </section>",
  "      <section class=\"conte-scene\" id=\"scene-8\" data-scene=\"8\">\n        <figure class=\"conte-fig\">\n            <img class=\"conte-img is-on\" data-beat=\"c08a\" src=\"assets/contes/chaperon-rouge/sm/c08a.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c08a.webp 640w, assets/contes/chaperon-rouge/c08a.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Une vision : les bêtes de la forêt marchent côte à côte dans la lumière\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c08b\" src=\"assets/contes/chaperon-rouge/sm/c08b.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c08b.webp 640w, assets/contes/chaperon-rouge/c08b.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Le loup, captivé, regarde Rouge avec curiosité\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c08c\" src=\"assets/contes/chaperon-rouge/sm/c08c.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c08c.webp 640w, assets/contes/chaperon-rouge/c08c.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge sourit ; une lumière s’allume près du cœur du loup\" loading=\"lazy\" decoding=\"async\">\n          <span class=\"conte-dots\" aria-hidden=\"true\"><i data-beat=\"c08a\" class=\"is-on\"></i><i data-beat=\"c08b\"></i><i data-beat=\"c08c\"></i></span>\n        </figure>\n        <div class=\"conte-text conte-text--lignes\"><p><span class=\"beat\" data-beat=\"c08a\">Elle partagea une vision : une forêt où les bêtes marchaient côte à côte, nourries par une énergie infinie, sans violence. </span><span class=\"beat\" data-beat=\"c08b\">Le loup, captivé, sentit son instinct vaciller. « Mais sans manger, comment puis-je être fort ? » demanda-t-il, sa voix rauque adoucie par la curiosité. </span><span class=\"beat\" data-beat=\"c08c\">Rouge sourit : « Tu es cause , comme moi. Observe la lumière , et elle te remplira. »</span><span class=\"conte-sep\" hidden> </span></p></div>\n        <button type=\"button\" class=\"btn btn-ghost conte-next\" data-i18n=\"conte.next\">Suite ▾</button>\n      </section>",
  "      <section class=\"conte-scene\" id=\"scene-9\" data-scene=\"9\">\n        <figure class=\"conte-fig\">\n            <img class=\"conte-img is-on\" data-beat=\"c09a\" src=\"assets/contes/chaperon-rouge/sm/c09a.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c09a.webp 640w, assets/contes/chaperon-rouge/c09a.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge et le loup respirent lentement dans les rayons du soleil\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c09b\" src=\"assets/contes/chaperon-rouge/sm/c09b.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c09b.webp 640w, assets/contes/chaperon-rouge/c09b.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Le cycle en trois temps, en anneaux de lumière : mettre en route, changer, arrêter\" loading=\"lazy\" decoding=\"async\">\n          <span class=\"conte-dots\" aria-hidden=\"true\"><i data-beat=\"c09a\" class=\"is-on\"></i><i data-beat=\"c09b\"></i></span>\n        </figure>\n        <div class=\"conte-text conte-text--lignes\"><p><span class=\"beat\" data-beat=\"c09a\">Elle lui montra comment respirer lentement, capter l’énergie des rayons du soleil, </span><span class=\"beat\" data-beat=\"c09b\">et programmer un cycle : mettre en route (ressentir la faim), changer (voir la lumière ), arrêter (choisir l’harmonie).</span><span class=\"conte-sep\" hidden> \n</span></p></div>\n        <button type=\"button\" class=\"btn btn-ghost conte-next\" data-i18n=\"conte.next\">Suite ▾</button>\n      </section>",
  "      <section class=\"conte-scene\" id=\"scene-10\" data-scene=\"10\">\n        <figure class=\"conte-fig\">\n            <img class=\"conte-img is-on\" data-beat=\"c10a\" src=\"assets/contes/chaperon-rouge/sm/c10a.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c10a.webp 640w, assets/contes/chaperon-rouge/c10a.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Le loup, émerveillé, sent une chaleur nouvelle en lui ; ses yeux s’adoucissent\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c10b\" src=\"assets/contes/chaperon-rouge/sm/c10b.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c10b.webp 640w, assets/contes/chaperon-rouge/c10b.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Le loup guide Rouge vers la maison de sa grand-mère\" loading=\"lazy\" decoding=\"async\">\n          <span class=\"conte-dots\" aria-hidden=\"true\"><i data-beat=\"c10a\" class=\"is-on\"></i><i data-beat=\"c10b\"></i></span>\n        </figure>\n        <div class=\"conte-text conte-text--lignes\"><p><span class=\"beat\" data-beat=\"c10a\">Le loup, émerveillé, sentit une chaleur nouvelle en lui. Ses crocs semblèrent fondre, </span><span class=\"beat\" data-beat=\"c10b\">et il murmura : « Je ne mangerai plus. Je serai ton guide, Rouge, vers la maison de ta grand-mère. »</span><span class=\"conte-sep\" hidden>\n</span></p></div>\n        <button type=\"button\" class=\"btn btn-ghost conte-next\" data-i18n=\"conte.next\">Suite ▾</button>\n      </section>",
  "      <section class=\"conte-scene\" id=\"scene-11\" data-scene=\"11\">\n        <figure class=\"conte-fig\">\n            <img class=\"conte-img is-on\" data-beat=\"c11a\" src=\"assets/contes/chaperon-rouge/sm/c11a.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c11a.webp 640w, assets/contes/chaperon-rouge/c11a.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"La grand-mère alitée tient une miche de pain ; Rouge arrive à la porte\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c11b\" src=\"assets/contes/chaperon-rouge/sm/c11b.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c11b.webp 640w, assets/contes/chaperon-rouge/c11b.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge perçoit la vieille croyance qui enchaîne sa grand-mère, comme des chaînes de brume\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c11c\" src=\"assets/contes/chaperon-rouge/sm/c11c.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c11c.webp 640w, assets/contes/chaperon-rouge/c11c.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge pose la fiole d’eau scintillante sur la table de chevet\" loading=\"lazy\" decoding=\"async\">\n          <span class=\"conte-dots\" aria-hidden=\"true\"><i data-beat=\"c11a\" class=\"is-on\"></i><i data-beat=\"c11b\"></i><i data-beat=\"c11c\"></i></span>\n        </figure>\n        <div class=\"conte-text conte-text--lignes\"><p><span class=\"beat\" data-beat=\"c11a\">Quand Rouge arriva chez sa grand-mère, elle trouva la vieille femme alitée, pâle, tenant une miche de pain qu’elle n’avait pas la force de manger. \n</span><span class=\"beat\" data-beat=\"c11b\">Rouge observa et perçut que sa grand-mère était enchaînée à une vieille croyance : manger du vivant pour survivre. </span><span class=\"beat\" data-beat=\"c11c\">Elle s’assit à son chevet, posa la fiole d’eau scintillante sur la table, et dit doucement : « Grand-mère, tu n’as pas besoin de ce pain. Regarde avec moi. »</span><span class=\"conte-sep\" hidden>\n</span></p></div>\n        <button type=\"button\" class=\"btn btn-ghost conte-next\" data-i18n=\"conte.next\">Suite ▾</button>\n      </section>",
  "      <section class=\"conte-scene\" id=\"scene-12\" data-scene=\"12\">\n        <figure class=\"conte-fig\">\n            <img class=\"conte-img is-on\" data-beat=\"c12a\" src=\"assets/contes/chaperon-rouge/sm/c12a.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c12a.webp 640w, assets/contes/chaperon-rouge/c12a.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge et sa grand-mère, main dans la main, les yeux fermés\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c12b\" src=\"assets/contes/chaperon-rouge/sm/c12b.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c12b.webp 640w, assets/contes/chaperon-rouge/c12b.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"La lumière de Rouge passe dans sa grand-mère ; les chaînes se défont\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c12c\" src=\"assets/contes/chaperon-rouge/sm/c12c.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c12c.webp 640w, assets/contes/chaperon-rouge/c12c.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Un souffle d’éternité entre en Rouge\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c12d\" src=\"assets/contes/chaperon-rouge/sm/c12d.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c12d.webp 640w, assets/contes/chaperon-rouge/c12d.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge vibre tout entière d’une énergie sans fin\" loading=\"lazy\" decoding=\"async\">\n          <span class=\"conte-dots\" aria-hidden=\"true\"><i data-beat=\"c12a\" class=\"is-on\"></i><i data-beat=\"c12b\"></i><i data-beat=\"c12c\"></i><i data-beat=\"c12d\"></i></span>\n        </figure>\n        <div class=\"conte-text conte-text--lignes\"><p><span class=\"beat\" data-beat=\"c12a\">Rouge prit la main de sa grand-mère et l’invita à observer . Ensemble, elles fermèrent les yeux, et Rouge partagea sa lumière . </span><span class=\"beat\" data-beat=\"c12b\">« La lumière est en toi, grand-mère. Elle te nourrit sans arracher la vie. Laisse aller la pensée que manger te sauve. » </span><span class=\"beat\" data-beat=\"c12c\">À cet instant, une immense force entra en Rouge, comme un souffle d’éternité. </span><span class=\"beat\" data-beat=\"c12d\">Elle réalisa qu’en se nourrissant de lumière , elle pouvait vivre éternellement – son corps, son esprit, tout son être vibraient d’une énergie sans fin.</span><span class=\"conte-sep\" hidden>\n</span></p></div>\n        <button type=\"button\" class=\"btn btn-ghost conte-next\" data-i18n=\"conte.next\">Suite ▾</button>\n      </section>",
  "      <section class=\"conte-scene\" id=\"scene-13\" data-scene=\"13\">\n        <figure class=\"conte-fig\">\n            <img class=\"conte-img is-on\" data-beat=\"c13a\" src=\"assets/contes/chaperon-rouge/sm/c13a.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c13a.webp 640w, assets/contes/chaperon-rouge/c13a.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Le cœur de la grand-mère s’allège ; une lueur douce dans ses yeux\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c13b\" src=\"assets/contes/chaperon-rouge/sm/c13b.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c13b.webp 640w, assets/contes/chaperon-rouge/c13b.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"La grand-mère boit une gorgée de l’eau scintillante et sourit\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c13c\" src=\"assets/contes/chaperon-rouge/sm/c13c.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c13c.webp 640w, assets/contes/chaperon-rouge/c13c.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Le loup, à l’entrée, regarde Rouge et sa grand-mère s’embrasser\" loading=\"lazy\" decoding=\"async\">\n          <span class=\"conte-dots\" aria-hidden=\"true\"><i data-beat=\"c13a\" class=\"is-on\"></i><i data-beat=\"c13b\"></i><i data-beat=\"c13c\"></i></span>\n        </figure>\n        <div class=\"conte-text conte-text--lignes\"><p><span class=\"beat\" data-beat=\"c13a\">La grand-mère, touchée par cette lumière , sentit son cœur s’alléger. Une lueur douce illumina ses yeux, et elle murmura : « Rouge, je vois… Moi aussi, je peux être éternelle. Je n’ai plus besoin de manger du vivant. » </span><span class=\"beat\" data-beat=\"c13b\">Elle lâcha le pain, but une gorgée de l’eau scintillante, et son visage s’éclaira d’un sourire. </span><span class=\"beat\" data-beat=\"c13c\">Le loup, qui les regardait depuis l’entrée, hocha la tête, comme s’il comprenait lui aussi cette vérité.</span><span class=\"conte-sep\" hidden>\n</span></p></div>\n        <button type=\"button\" class=\"btn btn-ghost conte-next\" data-i18n=\"conte.next\">Suite ▾</button>\n      </section>",
  "      <section class=\"conte-scene\" id=\"scene-14\" data-scene=\"14\">\n        <figure class=\"conte-fig\">\n            <img class=\"conte-img is-on\" data-beat=\"c14a\" src=\"assets/contes/chaperon-rouge/sm/c14a.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c14a.webp 640w, assets/contes/chaperon-rouge/c14a.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge, le loup et la grand-mère, gardiens lumineux de la forêt\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c14b\" src=\"assets/contes/chaperon-rouge/sm/c14b.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c14b.webp 640w, assets/contes/chaperon-rouge/c14b.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Rouge enseigne aux animaux et aux villageois à capter la lumière\" loading=\"lazy\" decoding=\"async\">\n          <span class=\"conte-dots\" aria-hidden=\"true\"><i data-beat=\"c14a\" class=\"is-on\"></i><i data-beat=\"c14b\"></i></span>\n        </figure>\n        <div class=\"conte-text conte-text--lignes\"><p><span class=\"beat\" data-beat=\"c14a\">De ce jour, Rouge, le loup, et la grand-mère devinrent des gardiens de la forêt. \n</span><span class=\"beat\" data-beat=\"c14b\">Rouge enseigna aux animaux et aux villageois comment capter la lumière , programmer leurs cycles avec amour, et vivre sans arracher la vie.</span><span class=\"conte-sep\" hidden> \n</span></p></div>\n        <button type=\"button\" class=\"btn btn-ghost conte-next\" data-i18n=\"conte.next\">Suite ▾</button>\n      </section>",
  "      <section class=\"conte-scene\" id=\"scene-15\" data-scene=\"15\">\n        <figure class=\"conte-fig\">\n            <img class=\"conte-img is-on\" data-beat=\"c15a\" src=\"assets/contes/chaperon-rouge/sm/c15a.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c15a.webp 640w, assets/contes/chaperon-rouge/c15a.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Le loup lumineux guide des âmes perdues vers la paix\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c15b\" src=\"assets/contes/chaperon-rouge/sm/c15b.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c15b.webp 640w, assets/contes/chaperon-rouge/c15b.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Sous les étoiles, la grand-mère raconte des histoires de lumière\" loading=\"lazy\" decoding=\"async\">\n            <img class=\"conte-img\" data-beat=\"c15c\" src=\"assets/contes/chaperon-rouge/sm/c15c.webp\" srcset=\"assets/contes/chaperon-rouge/sm/c15c.webp 640w, assets/contes/chaperon-rouge/c15c.webp 1280w\" sizes=\"(max-width: 760px) 100vw, 760px\" width=\"1280\" height=\"720\" alt=\"Les trois gardiens sous les étoiles ; des fils de lumière tissent l’harmonie de l’univers\" loading=\"lazy\" decoding=\"async\">\n          <span class=\"conte-dots\" aria-hidden=\"true\"><i data-beat=\"c15a\" class=\"is-on\"></i><i data-beat=\"c15b\"></i><i data-beat=\"c15c\"></i></span>\n        </figure>\n        <div class=\"conte-text conte-text--lignes\"><p><span class=\"beat\" data-beat=\"c15a\">Le loup, libéré de son programme, guida les âmes perdues vers la paix. </span><span class=\"beat\" data-beat=\"c15b\">Et la grand-mère, forte et éternelle, raconta des histoires de lumière sous les étoiles. </span><span class=\"beat\" data-beat=\"c15c\">Ensemble, ils reprogrammèrent l’univers, tissant une harmonie où la vie ne se nourrissait plus de mort, mais d’amour infini.</span></p></div>\n      </section>"
 ]
}