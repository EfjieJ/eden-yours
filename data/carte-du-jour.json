    {
      "id": "cdj-ql-c2207e547b",
      "lang": "fr",
      "text": "Nous sommes tous des beaux visages. Des yeux qui brillent sans forcer,",
      "trackId": "d34adae3-fd22-4ac7-80c3-6978b0457546",
      "title": "La beauté vénère",
